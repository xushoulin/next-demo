# ===== 大模型（阿里云百炼） =====
DASHSCOPE_API_KEY=sk-你的百炼APIKey
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 数据库（Neon PostgreSQL） =====
# 在 Neon 控制台 Connect 弹窗复制 pooled 连接串（带 -pooler 的 host），形如：
#   postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require

# ===== 登录 Cookie 签名密钥 =====
# 生产环境请替换为随机长字符串；留空则使用不安全的开发默认值。
AUTH_SECRET=replace-with-a-random-secret

# ===== Adsterra 广告（可选，全部留空则不展示任何广告）=====
# 在 publishers.adsterra.com 后台创建 Banner 广告位后，复制代码中的两个值填入：
#   NEXT_PUBLIC_ADSTERRA_BANNER_SRC  形如 //www.xxxxxxxx.com/123456/invoke.js
#   NEXT_PUBLIC_ADSTERRA_BANNER_KEY  形如 1a2b3c4d5e6f...
# 尺寸按广告位实际大小填写（默认 300x250）
NEXT_PUBLIC_ADSTERRA_BANNER_SRC=
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_WIDTH=300
NEXT_PUBLIC_ADSTERRA_BANNER_HEIGHT=250
# Social Bar / Popunder 为整站脚本，复制完整 <script src="..."> 中的地址：
# 注意：Popunder 侵入性强，AdSense 复审期间建议暂不开启
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_SRC=
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=
