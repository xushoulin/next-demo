# ===== 大模型（阿里云百炼） =====
DASHSCOPE_API_KEY=sk-你的百炼APIKey
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 数据库（Neon PostgreSQL） =====
# 在 Neon 控制台 Connect 弹窗复制 pooled 连接串（带 -pooler 的 host），形如：
#   postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require

# ===== 登录 Cookie 签名密钥 =====
# 生产环境请替换为随机长字符串；留空则使用不安全的开发默认值。
AUTH_SECRET=replace-with-a-random-secret
